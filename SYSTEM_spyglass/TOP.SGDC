current_design "TOP"

#=======================================================
# 1. Primary & Generated Clocks
#=======================================================
# the clock periods are made like that to avoid the max cycles limit of the tool because the ratio is the essential factor in the CDC
clock -name REF_CLK                   -domain DOMAIN_REF  -period 10 -edge {0 5}
clock -name UART_CLK                  -domain DOMAIN_UART -period 20 -edge {0 10}
clock -name clk_div_RX_u.o_div_clk    -domain DOMAIN_UART -period 40 -edge {0 20}
clock -name clk_div_TX_u.o_div_clk    -domain DOMAIN_UART -period 80 -edge {0 40}

#=======================================================
# 2. Resets (Using RTL ports and top-level wires)
#=======================================================
reset -name RST -value 0
reset -name SYNC_RST_1 -value 0
reset -name SYNC_RST_2 -value 0
abstract_port -ports RST -ignore

#=======================================================
# 3. Primary I/O Ports
#=======================================================
input  -name RX_IN         -clock UART_CLK
output -name TX_OUT        -clock UART_CLK
output -name framing_error -clock UART_CLK
output -name parity_error  -clock UART_CLK

#=======================================================
# 4. Quasi-Static & Case Analysis for Configuration Registers
# Fixes configuration bits as quasi-static / constant mode
# so Ac_unsync and Clock_glitch04 are eliminated
#=======================================================


# TX Div Ratio = 32 (8'b0010_0000)
set_case_analysis -name REG3[7] -value 0
set_case_analysis -name REG3[6] -value 0
set_case_analysis -name REG3[5] -value 1
set_case_analysis -name REG3[4] -value 0
set_case_analysis -name REG3[3] -value 0
set_case_analysis -name REG3[2] -value 0
set_case_analysis -name REG3[1] -value 0
set_case_analysis -name REG3[0] -value 0

# Prescale = 8 -> REG2[7:2] = 6'b001000 (RX Div Ratio = 4)
set_case_analysis -name REG2[7] -value 0
set_case_analysis -name REG2[6] -value 0
set_case_analysis -name REG2[5] -value 1
set_case_analysis -name REG2[4] -value 0
set_case_analysis -name REG2[3] -value 0
set_case_analysis -name REG2[2] -value 0

# Parity Configuration: Even Parity (REG2[1] = 0), Parity Enabled (REG2[0] = 1)
set_case_analysis -name REG2[1] -value 0
set_case_analysis -name REG2[0] -value 1


#=======================================================
# 5. FIFO Memory (RTL instance path)
#=======================================================
fifo -memory FIFO_u.FIFO_MEM_u.mem

#=======================================================
# 6. Convergence & False Path Constraints
#=======================================================
# Mark FIFO status (FULL) and UART RX valid as unrelated events for SYS_CTRL
cdc_attribute -unrelated {FULL sync_RX_OUT_data_valid}
cdc_attribute -unrelated {TOP.FIFO_u.SYNC_R2W_u.sync_reg TOP.synchronizer_u.sync_reg}

# Exclude FIFO status flags from false convergence checks
no_convergence_check -name {FULL EMPTY}

# FIFO memory to UART TX capture registers (protected by FIFO !EMPTY and FULL flags)
cdc_false_path -from TOP.FIFO_u.FIFO_MEM_u.mem[7:0][7:0] -from_type flop -to TOP.UART_u.UART_TX_u.u1.ser_data -to_type flop
cdc_false_path -from TOP.FIFO_u.FIFO_MEM_u.mem[7:0][7:0] -from_type flop -to TOP.UART_u.UART_TX_u.u2.par_bit -to_type flop

